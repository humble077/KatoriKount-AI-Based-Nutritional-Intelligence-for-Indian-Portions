{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "streamlit run app.py --server.port=${PORT:-8501} --server.address=0.0.0.0 --server.enableCORS=false --server.enableXsrfProtection=false --server.headless=true --server.maxUploadSize=50",
    "restartPolicy": "always",
    "healthcheck": {
      "path": "/",
      "interval": 30,
      "timeout": 10,
      "retries": 3
    }
  }
} 